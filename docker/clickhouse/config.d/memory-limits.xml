<clickhouse>
  <max_server_memory_usage_to_ram_ratio>0.80</max_server_memory_usage_to_ram_ratio>

  <!--
    The (total) memory tracker drifts upward over time (allocations whose frees
    are not re-attributed: killed queries, in-flight inserts, jemalloc arenas).
    Once the tracked total passes max_server_memory_usage every query fails with
    code 241 even though real RSS is far below the cap, and the server never
    recovers without a restart. Let the background memory worker correct the
    tracker against the real usage reported by jemalloc/cgroups.
  -->
  <memory_worker_correct_memory_tracker>1</memory_worker_correct_memory_tracker>
  <mark_cache_size>33554432</mark_cache_size>
  <uncompressed_cache_size>16777216</uncompressed_cache_size>
  <background_pool_size>2</background_pool_size>
  <background_merges_mutations_concurrency_ratio>2</background_merges_mutations_concurrency_ratio>

  <merge_tree>
    <number_of_free_entries_in_pool_to_execute_mutation>4</number_of_free_entries_in_pool_to_execute_mutation>
    <number_of_free_entries_in_pool_to_lower_max_size_of_merge>4</number_of_free_entries_in_pool_to_lower_max_size_of_merge>
    <number_of_free_entries_in_pool_to_execute_optimize_entire_partition>4</number_of_free_entries_in_pool_to_execute_optimize_entire_partition>
  </merge_tree>

  <!--
    Server total memory auto-scales via max_server_memory_usage_to_ram_ratio
    above, so no machine profile is needed here. The per-query defaults below are
    only a safety floor for queries that arrive WITHOUT explicit SETTINGS; the
    backend sends its own adaptive per-query budget (see the tuning controller),
    so these match the backend's safe floor (64 MiB) rather than any tier.
  -->
  <profiles>
    <default>
      <max_memory_usage>67108864</max_memory_usage>
      <max_bytes_before_external_group_by>16777216</max_bytes_before_external_group_by>
      <max_bytes_before_external_sort>16777216</max_bytes_before_external_sort>
      <max_temporary_data_on_disk_size_for_query>1073741824</max_temporary_data_on_disk_size_for_query>
      <max_execution_time>8</max_execution_time>
      <max_threads>2</max_threads>
      <group_by_two_level_threshold>10000</group_by_two_level_threshold>
      <group_by_two_level_threshold_bytes>33554432</group_by_two_level_threshold_bytes>
    </default>
  </profiles>
</clickhouse>
