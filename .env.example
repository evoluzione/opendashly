# -----------------------------------------------------------------------------
# Opendashly environment example
# Copy to .env and customize values for your environment.
# -----------------------------------------------------------------------------

# Required secrets
AUTH_SECRET=replace-with-32-plus-random-chars
CLICKHOUSE_PASSWORD=replace-with-strong-password

# CORS
CORS_ALLOWED_ORIGINS=http://your-host:5173

# -----------------------------------------------------------------------------
# Self-tuning (no machine profiles)
#
# There are no small/standard/big profiles to pick. The backend starts its
# load-sensitive knobs (query parallelism, telemetry concurrency, per-query
# ClickHouse memory) at a safe floor and adapts them at runtime to real
# pressure. The collector sizes its memory limiter at boot from the container's
# cgroup memory limit. ClickHouse scales its server memory from available RAM.
#
# Nothing to configure here. To cap the collector on a constrained host, set
# its mem_limit in compose; to pin the collector limiter explicitly, you may set
# OTEL_MEMORY_LIMIT_MIB as an escape hatch.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Optional ClickHouse port bindings (published only on localhost in prod compose)
# -----------------------------------------------------------------------------
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_TCP_PORT=9000
