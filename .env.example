# -----------------------------------------------------------------------------
# Opendashly environment example
# Copy to .env and customize values for your environment.
# -----------------------------------------------------------------------------

# Required secrets
AUTH_SECRET=replace-with-32-plus-random-chars
CLICKHOUSE_PASSWORD=replace-with-strong-password

# CORS
CORS_ALLOWED_ORIGINS=http://your-host:5173

# -----------------------------------------------------------------------------
# Machine sizing (auto-tuning)
#
# Use ONE of these approaches:
# 1) Preset profile: small, standard, big
# 2) Explicit hardware hints: MACHINE_RAM_GB + MACHINE_CPU_CORES
#
# When MACHINE_* is set, backend and collector low-level tuning values
# are derived automatically from the selected/derived profile.
# -----------------------------------------------------------------------------
MACHINE_PROFILE=standard
# MACHINE_RAM_GB=4
# MACHINE_CPU_CORES=2

# -----------------------------------------------------------------------------
# Optional ClickHouse port bindings (published only on localhost in prod compose)
# -----------------------------------------------------------------------------
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_TCP_PORT=9000
