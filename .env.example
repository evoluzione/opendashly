# Opendashly environment example
# Only secrets and deployment-facing policy live here.
# All runtime/tuning knobs are auto-derived from resources and live pressure.

# Required in production
AUTH_SECRET=replace-with-32-plus-random-chars
CLICKHOUSE_PASSWORD=replace-with-strong-password

# CORS policy for the frontend/API origin(s), comma-separated when needed
CORS_ALLOWED_ORIGINS=http://your-host:5173
